# Copy to terraform.tfvars and fill in. These are identifiers, not secrets:
# your API private key stays in %USERPROFILE%\.oci\ and is read from ~/.oci/config.

region           = "eu-stockholm-1"          # your home region
compartment_ocid = "ocid1.tenancy.oc1..aaaa" # tenancy OCID = root compartment

# Sites allowed to use the proxy (your deployed web app + local dev)
allowed_origins = ["https://your-site.example.com", "http://localhost:*"]

# Optional
# ssh_public_key_path       = "~/.ssh/id_ed25519.pub"
# ssh_allowed_cidr          = "203.0.113.7/32"
# domain                    = "proxy.example.com"   # empty = <ip>.sslip.io
# availability_domain_index = 1                     # try 1 or 2 on "Out of host capacity"
# shape                     = "VM.Standard.E2.1.Micro"
