#cloud-config
# First-boot setup for the EDOPro web proxy: Node.js 22, Caddy in front for
# HTTPS/WebSockets, then deploy.sh (rendered from deploy.sh.tftpl) installs the
# proxy, its systemd service and the daily accounts maintenance timer.
# Later updates go through the same deploy.sh via `terraform apply`.

package_update: true
packages:
  - curl

write_files:
  - path: /opt/edopro-proxy/deploy.sh
    encoding: gz+b64
    permissions: "0700"
    content: ${deploy_sh}
  - path: /opt/edopro-proxy/setup.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euxo pipefail

      # Node.js 22 (NodeSource); 22.13+ has the built-in SQLite the accounts use.
      curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
      apt-get install -y nodejs

      # Caddy from Ubuntu's own repository (Caddy's Cloudsmith apt repo returns 402).
      apt-get install -y caddy

      # Oracle's Ubuntu images ship iptables rules that only allow SSH: open 80 and 443.
      iptables -C INPUT -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -j ACCEPT 2>/dev/null \
        || iptables -I INPUT -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -j ACCEPT
      netfilter-persistent save

      # Hostname for the certificate: the configured domain, or <ip>.sslip.io.
      DOMAIN="${domain}"
      if [ -z "$DOMAIN" ]; then
        IP="$(curl -fsS https://api.ipify.org)"
        DOMAIN="$(echo "$IP" | tr . -).sslip.io"
      fi
      echo "$DOMAIN" > /opt/edopro-proxy/domain

      cat > /etc/caddy/Caddyfile <<CADDY
      $DOMAIN {
        reverse_proxy 127.0.0.1:7000
      }
      CADDY

      # The proxy itself, its service and the maintenance timer.
      bash /opt/edopro-proxy/deploy.sh
      systemctl restart caddy

runcmd:
  - [bash, /opt/edopro-proxy/setup.sh]
