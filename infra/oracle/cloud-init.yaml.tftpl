#cloud-config
# First-boot setup for the EDOPro web proxy: Node.js 22, the proxy as a
# systemd service on 127.0.0.1:7000, and Caddy in front for HTTPS/WebSockets.

package_update: true
packages:
  - curl

write_files:
  - path: /opt/edopro-proxy/src/server.mjs
    encoding: gz+b64
    content: ${server_mjs}
  - path: /opt/edopro-proxy/src/websocket.mjs
    encoding: gz+b64
    content: ${websocket_mjs}
  - path: /opt/edopro-proxy/package.json
    encoding: gz+b64
    content: ${package_json}
  - path: /opt/edopro-proxy/config.json
    encoding: gz+b64
    content: ${config_json}
  - path: /etc/systemd/system/edopro-proxy.service
    content: |
      [Unit]
      Description=EDOPro web proxy
      After=network-online.target
      Wants=network-online.target

      [Service]
      User=edoproxy
      WorkingDirectory=/opt/edopro-proxy
      ExecStart=/usr/bin/node src/server.mjs config.json
      Restart=always
      RestartSec=2
      NoNewPrivileges=true
      ProtectSystem=strict
      ProtectHome=true
      PrivateTmp=true

      [Install]
      WantedBy=multi-user.target
  - path: /opt/edopro-proxy/setup.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euxo pipefail

      # Node.js 22 (NodeSource)
      curl -fsSL https://deb.nodesource.com/setup_22.x | bash -
      apt-get install -y nodejs

      # Caddy from Ubuntu's own repository (Caddy's Cloudsmith apt repo returns 402).
      apt-get install -y caddy

      # Oracle's Ubuntu images ship iptables rules that only allow SSH: open 80 and 443.
      iptables -C INPUT -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -j ACCEPT 2>/dev/null \
        || iptables -I INPUT -p tcp -m multiport --dports 80,443 -m conntrack --ctstate NEW -j ACCEPT
      netfilter-persistent save

      # Hostname for the certificate: the configured domain, or <ip>.sslip.io.
      DOMAIN="${domain}"
      if [ -z "$DOMAIN" ]; then
        IP="$(curl -fsS https://api.ipify.org)"
        DOMAIN="$(echo "$IP" | tr . -).sslip.io"
      fi
      echo "$DOMAIN" > /opt/edopro-proxy/domain

      cat > /etc/caddy/Caddyfile <<CADDY
      $DOMAIN {
        reverse_proxy 127.0.0.1:7000
      }
      CADDY

      id edoproxy >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin edoproxy
      chown -R edoproxy:edoproxy /opt/edopro-proxy

      systemctl daemon-reload
      systemctl enable --now edopro-proxy
      systemctl restart caddy

runcmd:
  - [bash, /opt/edopro-proxy/setup.sh]
