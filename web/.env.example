# EDOPro Web configuration. Restart `npm run dev` (or rebuild) after editing.
# Copy this file to .env and edit it. .env is not committed.

# WebSocket / room-list proxy (proxy/ folder)
NEXT_PUBLIC_PROXY_URL=http://localhost:7000

# Card images. {code} is replaced with the card passcode.
NEXT_PUBLIC_CARD_IMAGE_URL=https://images.ygoprodeck.com/images/cards/{code}.jpg

# Card back image. Empty = bundled public/img/card-back.jpg
NEXT_PUBLIC_CARD_BACK_URL=

# Card databases (.cdb), comma-separated. Later ones override earlier ones.
# "github:owner/repo[/folder][@branch]" loads every .cdb in that folder.
NEXT_PUBLIC_DATABASES=github:ProjectIgnis/BabelCDB

# EDOPro strings.conf
NEXT_PUBLIC_STRINGS_URL=https://raw.githubusercontent.com/ProjectIgnis/Distribution/master/config/strings.conf

# Banlists (.lflist.conf), comma-separated. "github:owner/repo" loads every .lflist.conf.
NEXT_PUBLIC_BANLISTS=github:ProjectIgnis/LFLists

# Link to the source code shown in the header (AGPL-3.0). Empty = hidden.
NEXT_PUBLIC_SOURCE_URL=

# Optional: serve the site from a sub-path (e.g. GitHub Pages /repo-name)
NEXT_PUBLIC_BASE_PATH=
